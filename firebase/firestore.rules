rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function superAdmin() {
      return signedIn()
        && request.auth.token.email == 'fc781117@gmail.com';
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userExists() {
      return signedIn() && exists(userPath());
    }

    function userDoc() {
      return get(userPath());
    }

    function activeUser() {
      return userExists() && userDoc().data.status == 'active';
    }

    function isActive() {
      return superAdmin() || activeUser();
    }

    function sameBrigade(brigade) {
      return superAdmin()
        || (activeUser() && userDoc().data.brigade == brigade);
    }

    function commandRole() {
      return userExists()
        && userDoc().data.role in [
          'battalion',
          'commander',
          'sector',
          'safety',
          'recorder',
          'unit'
        ];
    }

    function chiefRole() {
      return userExists()
        && userDoc().data.role in [
          'battalion',
          'commander'
        ];
    }

    function canWrite(brigade) {
      return superAdmin()
        || (sameBrigade(brigade) && commandRole());
    }

    function protectedUserFieldsChanged() {
      return request.resource.data.diff(resource.data).changedKeys().hasAny([
        'status',
        'role',
        'isSuperAdmin',
        'approvedBy',
        'approvedAt'
      ]);
    }

    match /users/{userId} {
      // 最高管理員第一次登入時，前端會自動建立 active/admin 使用者文件。
      // 一般使用者第一次登入只能建立 pending 文件，等待最高管理員啟用。
      allow create: if superAdmin()
        || (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.status == 'pending'
        );

      allow read: if superAdmin()
        || (signedIn() && request.auth.uid == userId)
        || (isActive() && sameBrigade(resource.data.brigade));

      // 一般使用者不能自行改 status / role / isSuperAdmin / approvedBy / approvedAt。
      // 最高管理員可全域管理使用者。
      allow update: if superAdmin()
        || (
          signedIn()
          && request.auth.uid == userId
          && resource.data.email != 'fc781117@gmail.com'
          && !protectedUserFieldsChanged()
        );

      // 最高管理員不能被刪除。
      allow delete: if superAdmin()
        && resource.data.email != 'fc781117@gmail.com';
    }

    match /cases/{caseId} {
      allow create: if isActive()
        && (
          superAdmin()
          || (activeUser() && request.resource.data.brigade == userDoc().data.brigade)
        );

      allow read: if superAdmin()
        || sameBrigade(resource.data.brigade);

      allow update: if canWrite(resource.data.brigade);

      allow delete: if superAdmin()
        || (sameBrigade(resource.data.brigade) && chiefRole());

      match /{subCollection}/{docId} {
        allow read: if superAdmin()
          || sameBrigade(get(/databases/$(database)/documents/cases/$(caseId)).data.brigade);

        allow create, update, delete: if canWrite(get(/databases/$(database)/documents/cases/$(caseId)).data.brigade);
      }
    }
  }
}
