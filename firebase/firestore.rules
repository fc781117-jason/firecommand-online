rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function superAdmin() {
      return signedIn()
        && request.auth.token.email == 'fc781117@gmail.com';
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userExists() {
      return signedIn() && exists(userPath());
    }

    function userDoc() {
      return get(userPath());
    }

    function activeUser() {
      return userExists() && userDoc().data.status == 'active';
    }

    function isActive() {
      return superAdmin() || activeUser();
    }

    function sameBrigade(brigade) {
      return superAdmin()
        || (activeUser() && userDoc().data.brigade == brigade);
    }

    function commandRole() {
      return userExists()
        && userDoc().data.role in [
          'battalion',
          'commander',
          'sector',
          'safety',
          'recorder',
          'unit'
        ];
    }

    function chiefRole() {
      return userExists()
        && userDoc().data.role in [
          'battalion',
          'commander'
        ];
    }

    function canWrite(brigade) {
      return superAdmin()
        || (sameBrigade(brigade) && commandRole());
    }

    function protectedUserFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'status',
        'role',
        'isSuperAdmin',
        'approvedBy',
        'approvedAt'
      ]);
    }

    match /users/{userId} {
      // 最高管理員第一次登入時，前端會自動建立 active/admin 使用者文件。
      // 一般使用者第一次登入只能建立 pending 文件，等待最高管理員啟用。
      allow create: if superAdmin()
        || (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.status == 'pending'
        );

      allow read: if superAdmin()
        || (signedIn() && request.auth.uid == userId)
        || (isActive() && sameBrigade(resource.data.brigade));

      // 一般使用者不能自行改 status / role / isSuperAdmin / approvedBy / approvedAt。
      // 最高管理員可全域管理使用者。
      allow update: if superAdmin()
        || (
          signedIn()
          && request.auth.uid == userId
          && resource.data.email != 'fc781117@gmail.com'
          && !protectedUserFieldsChanged()
        );

      // 最高管理員不能被刪除。
      allow delete: if superAdmin()
        && resource.data.email != 'fc781117@gmail.com';
    }

    match /cases/{caseId} {
      function room() { return get(/databases/$(database)/documents/cases/$(caseId)).data; }
      function practice() { return room().get('mode','live') == 'practice'; }
      function host() { return signedIn() && room().hostUid == request.auth.uid; }
      function playerPath() { return /databases/$(database)/documents/cases/$(caseId)/players/$(request.auth.uid); }
      function member() { return signedIn() && exists(playerPath()) && get(playerPath()).data.ai == false; }
      function participant() { return member() && get(playerPath()).data.role != '觀察員'; }
      function scope() { return sameBrigade(room().brigade); }
      function actorRole() { return get(playerPath()).data.role; }
      function validRole(role) { return role in ['現場指揮官','初期指揮官','安全官','紀錄官','分區指揮官','單位帶隊官','觀察員']; }
      allow create: if isActive() && sameBrigade(request.resource.data.brigade)
        && (request.resource.data.get('mode','live') != 'practice'
          || (request.resource.data.hostUid == request.auth.uid
            && request.resource.data.instructorMode in ['ai','human']
            && (request.resource.data.instructorMode == 'ai' && request.resource.data.instructorUid == null
              || request.resource.data.instructorMode == 'human' && request.resource.data.instructorUid == request.auth.uid)));
      allow read: if sameBrigade(resource.data.brigade);
      allow update: if sameBrigade(resource.data.brigade)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['brigade','mode','hostUid','instructorUid','instructorMode','traineeUid','roomCode','createdBy'])
        && ((resource.data.get('mode','live') != 'practice' && canWrite(resource.data.brigade))
          || (resource.data.get('mode','live') == 'practice' && (host()
            || (participant() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['training','practiceStatus','nextPracticeEventAt','lastPracticeEventAt','practiceEventIntervalMs','scenarioTitle','scenarioBrief','learningMode'])))));
      allow delete: if superAdmin() || (sameBrigade(resource.data.brigade) && (chiefRole() || (resource.data.get('mode','live') == 'practice' && host())));

      match /players/{playerId} {
        allow read: if scope();
        allow create, update: if scope() && practice() && (
          (playerId == request.auth.uid && request.resource.data.userId == request.auth.uid
            && request.resource.data.ai == false
            && (validRole(request.resource.data.role) || (host() && room().get('instructorMode','ai') == 'human' && request.resource.data.role == '教官')))
          || (host() && request.resource.data.ai == true && validRole(request.resource.data.role)));
        allow delete: if scope() && practice() && (host() || playerId == request.auth.uid);
      }
      match /simulationEvents/{eventId} {
        allow read: if scope();
        allow write: if scope() && practice() && host();
      }
      match /practiceResponses/{responseId} {
        allow read: if scope();
        allow create: if scope() && practice() && participant()
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.role == actorRole()
          && request.resource.data.text is string && request.resource.data.text.size() >= 8 && request.resource.data.text.size() <= 3000
          && room().training.phase == 'running';
        allow update, delete: if false;
      }
      match /practiceMessages/{messageId} {
        allow read: if scope();
        allow create, update: if scope() && practice() && host() && request.resource.data.authorUid == request.auth.uid;
        allow delete: if false;
      }
      match /intakeEvents/{eventId} {
        allow read: if scope();
        allow create: if scope() && ((!practice() && canWrite(room().brigade)) || (practice() && participant()))
          && request.resource.data.authorUid == request.auth.uid
          && room().get('status','active') != 'closed'
          && request.resource.data.caseId == caseId
          && request.resource.data.kind in ['apply','undo']
          && request.resource.data.raw is string && request.resource.data.raw.size() <= 6000
          && request.resource.data.writes is list && request.resource.data.writes.size() <= 100;
        allow update, delete: if false;
      }
      match /{subCollection}/{docId} {
        allow read: if scope();
        // Explicit exclusions prevent the generic collaboration rule from bypassing instructor privileges.
        allow create, update, delete: if !(subCollection in ['players','simulationEvents','practiceResponses','practiceMessages','intakeEvents'])
          && scope() && ((!practice() && canWrite(room().brigade)) || (practice() && participant()));
      }
    }
  }
}
