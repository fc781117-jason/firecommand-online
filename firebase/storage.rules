rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function userActive() {
      return signedIn() && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == 'active';
    }
    function caseAllowed(caseId) {
      return signedIn() && firestore.exists(/databases/(default)/documents/cases/$(caseId))
        && (request.auth.token.email == 'fc781117@gmail.com'
          || (userActive() && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.brigade
            == firestore.get(/databases/(default)/documents/cases/$(caseId)).data.brigade));
    }
    function caseWriter(caseId) {
      return caseAllowed(caseId) && (request.auth.token.email == 'fc781117@gmail.com'
        || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role
          in ['battalion','commander','sector','safety','recorder','unit']);
    }
    match /user-photos/{userId}/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == userId && request.resource.size < 5 * 1024 * 1024;
    }
    match /case-photos/{caseId}/{fileName} {
      allow read: if caseAllowed(caseId);
      allow create, update: if caseWriter(caseId) && request.resource != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if caseWriter(caseId);
    }
    match /case-private/{caseId}/{folder}/{fileName} {
      allow read: if caseAllowed(caseId) && folder in ['contacts','hazards'];
      allow create, update: if caseWriter(caseId) && folder in ['contacts','hazards']
        && request.resource != null && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if caseWriter(caseId) && folder in ['contacts','hazards'];
    }
  }
}
