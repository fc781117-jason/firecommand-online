rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    match /user-photos/{userId}/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == userId && request.resource.size < 5 * 1024 * 1024;
    }
    match /case-photos/{caseId}/{fileName} {
      allow read, write: if signedIn() && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
